{
  // Default interpreter: this repo's "papers" conda environment.
  "python.defaultInterpreterPath": "C:/miniconda3/envs/papers/python.exe",
  // Path to the conda executable so that VS Code discovers the environments.
  "python.condaPath": "C:/miniconda3/Scripts/conda.exe",
  // Activate the environment automatically when opening an integrated terminal.
  "python.terminal.activateEnvironment": true,
  // Notebooks resolve paths from the repo root (to read data / relative paths).
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "python-envs.defaultEnvManager": "ms-python.python:conda",
  "python-envs.defaultPackageManager": "ms-python.python:conda"
}
